{
  "name": "short-builds",
  "version": "1.0.0",
  "description": "SWE40006 Group 6 - URL shortener with a CI/CD pipeline on AWS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --runInBand"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80
      }
    }
  }
}
